[Unit]
Description=Kurage Growth Hermes Commander
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kojima/work/kgrowth
Environment=HOME=/home/kojima
Environment=PATH=/home/kojima/.nvm/versions/node/v24.16.0/bin:/home/kojima/.npm-global/bin:/home/kojima/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/kojima/work/kgrowth/scripts/run_hermes_growth_commander.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
